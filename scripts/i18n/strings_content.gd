# -------------------------------------------------------- special calls

"special.gala_relampago.title": {
	"pt_BR": "Escala Relâmpago", "en": "Lightning Call", "es": "Escala Relámpago",
	"fr": "Escale Éclair", "de": "Blitzanlauf", "it": "Scalo Lampo",
	"ru": "Молниеносный заход", "pl": "Błyskawiczne Zawinięcie", "tr": "Yıldırım Uğrak"},
"special.gala_relampago.brief": {
	"pt_BR": "Um armador pagou pra furar a fila. O navio já está na barra e só encosta se a gente garantir a operação inteira num turno.",
	"en": "A shipowner paid to jump the queue. The ship is already at the bar and only comes alongside if we guarantee the whole operation in one shift.",
	"es": "Un armador pagó para saltarse la fila. El barco ya está en la barra y solo atraca si garantizamos toda la operación en un turno.",
	"fr": "Un armateur a payé pour griller la file. Le navire est déjà à la barre et n'accoste que si on garantit toute l'opération en un service.",
	"de": "Ein Reeder hat fürs Vordrängeln bezahlt. Das Schiff liegt schon an der Barre und legt nur an, wenn wir alles in einer Schicht schaffen.",
	"it": "Un armatore ha pagato per saltare la coda. La nave è già alla barra e attracca solo se garantiamo tutta l'operazione in un turno.",
	"ru": "Судовладелец заплатил, чтобы пройти без очереди. Судно уже на баре и встанет к причалу, только если мы гарантируем всю операцию за смену.",
	"pl": "Armator zapłacił, żeby ominąć kolejkę. Statek jest już na redzie i przybije tylko, jeśli zagwarantujemy całą operację w jedną zmianę.",
	"tr": "Bir armatör sırayı atlamak için para ödedi. Gemi limanın ağzında ve tüm operasyonu tek vardiyada garanti edersek yanaşacak."},
"special.carga_projeto.title": {
	"pt_BR": "Carga de Projeto", "en": "Project Cargo", "es": "Carga de Proyecto",
	"fr": "Colis Exceptionnel", "de": "Projektladung", "it": "Carico di Progetto",
	"ru": "Проектный груз", "pl": "Ładunek Projektowy", "tr": "Proje Yükü"},
"special.carga_projeto.brief": {
	"pt_BR": "Peças de usina, altas e sem prumo. Empilhar isso é serviço de quem tem pulso, e o frete vem no mesmo tamanho do risco.",
	"en": "Power-plant parts, tall and off-plumb. Stacking this takes a steady hand, and the freight is as big as the risk.",
	"es": "Piezas de central eléctrica, altas y sin aplomo. Apilar esto es trabajo de pulso firme, y el flete viene del tamaño del riesgo.",
	"fr": "Des pièces de centrale, hautes et de travers. Les empiler demande du doigté, et le fret est à la mesure du risque.",
	"de": "Kraftwerksteile, hoch und schief. Das zu stapeln braucht eine ruhige Hand, und die Fracht ist so groß wie das Risiko.",
	"it": "Pezzi di centrale, alti e fuori piombo. Impilarli è lavoro da mano ferma, e il nolo è grande quanto il rischio.",
	"ru": "Детали электростанции, высокие и кривые. Штабелировать такое — работа для твёрдой руки, и фрахт под стать риску.",
	"pl": "Części elektrowni, wysokie i krzywe. Układanie tego wymaga pewnej ręki, a fracht jest tak duży jak ryzyko.",
	"tr": "Santral parçaları, yüksek ve eğri. Bunları istiflemek sağlam el ister; navlun da risk kadar büyük."},
"special.janela_de_mare.title": {
	"pt_BR": "Janela de Maré", "en": "Tide Window", "es": "Ventana de Marea",
	"fr": "Fenêtre de Marée", "de": "Tidenfenster", "it": "Finestra di Marea",
	"ru": "Окно прилива", "pl": "Okno Pływu", "tr": "Gelgit Penceresi"},
"special.janela_de_mare.brief": {
	"pt_BR": "A maré fecha em quarenta segundos e o ULCV não espera. Se ele sair carregado, o porto entra na rota de vez.",
	"en": "The tide closes in forty seconds and the ULCV won't wait. If it leaves loaded, the port is on the route for good.",
	"es": "La marea cierra en cuarenta segundos y el ULCV no espera. Si sale cargado, el puerto entra en la ruta para siempre.",
	"fr": "La marée se ferme dans quarante secondes et l'ULCV n'attendra pas. S'il repart chargé, le port entre pour de bon dans la ligne.",
	"de": "Die Tide schließt in vierzig Sekunden, und das ULCV wartet nicht. Fährt es beladen ab, ist der Hafen fest auf der Route.",
	"it": "La marea chiude tra quaranta secondi e l'ULCV non aspetta. Se esce carico, il porto entra nella rotta per sempre.",
	"ru": "Прилив закроется через сорок секунд, а ULCV ждать не станет. Уйдёт гружёным — порт войдёт в линию навсегда.",
	"pl": "Pływ zamyka się za czterdzieści sekund, a ULCV nie poczeka. Jeśli wypłynie załadowany, port na stałe trafi na trasę.",
	"tr": "Gelgit kırk saniyede kapanıyor ve ULCV beklemez. Yüklü çıkarsa liman rotaya kalıcı olarak girer."},
"special.resgate_de_feeder.title": {
	"pt_BR": "Resgate de Feeder", "en": "Feeder Rescue", "es": "Rescate de Feeder",
	"fr": "Sauvetage de Feeder", "de": "Feeder-Rettung", "it": "Soccorso al Feeder",
	"ru": "Спасение фидера", "pl": "Ratunek Feedera", "tr": "Besleyici Kurtarma"},
"special.resgate_de_feeder.brief": {
	"pt_BR": "Um feeder encalhou o próprio embarque em outro terminal e chegou aqui pedindo socorro. Serviço pequeno, prazo curto, gratidão grande.",
	"en": "A feeder had its own loading stranded at another terminal and came here asking for help. Small job, short deadline, big gratitude.",
	"es": "Un feeder se quedó sin su embarque en otra terminal y llegó aquí pidiendo auxilio. Trabajo pequeño, plazo corto, gratitud grande.",
	"fr": "Un feeder a vu son chargement bloqué dans un autre terminal et vient ici demander de l'aide. Petit boulot, délai court, grande gratitude.",
	"de": "Ein Feeder ist an einem anderen Terminal mit seiner Ladung hängengeblieben und bittet hier um Hilfe. Kleiner Job, kurze Frist, großer Dank.",
	"it": "Un feeder è rimasto col carico bloccato in un altro terminal ed è arrivato qui a chiedere aiuto. Lavoro piccolo, scadenza breve, gratitudine grande.",
	"ru": "У фидера сорвалась погрузка на другом терминале, и он пришёл сюда за помощью. Работа маленькая, срок короткий, благодарность большая.",
	"pl": "Feeder utknął z ładunkiem w innym terminalu i przypłynął tu po pomoc. Mała robota, krótki termin, wielka wdzięczność.",
	"tr": "Bir besleyici gemi yüklemesini başka terminalde kaybetti ve yardım istemeye geldi. Küçük iş, kısa süre, büyük minnet."},
"special.carga_perdida.title": {
	"pt_BR": "Carga Perdida no Pátio", "en": "Lost Cargo in the Yard",
	"es": "Carga Perdida en el Patio", "fr": "Fret Perdu au Parc",
	"de": "Verlorene Fracht im Lager", "it": "Carico Perso nel Piazzale",
	"ru": "Потерянный груз на площадке", "pl": "Zgubiony Ładunek na Placu",
	"tr": "Sahada Kayıp Yük"},
"special.carga_perdida.brief": {
	"pt_BR": "O sistema caiu no meio do turno e três contêineres sumiram do mapa. Estão no pátio, em algum lugar. O navio sai com maré, achando ou não.",
	"en": "The system crashed mid-shift and three containers vanished from the map. They're in the yard, somewhere. The ship sails with the tide, found or not.",
	"es": "El sistema se cayó a mitad del turno y tres contenedores desaparecieron del mapa. Están en el patio, en algún lado. El barco sale con la marea, los encuentres o no.",
	"fr": "Le système a planté en plein service et trois conteneurs ont disparu de la carte. Ils sont au parc, quelque part. Le navire part avec la marée, trouvés ou pas.",
	"de": "Mitten in der Schicht ist das System abgestürzt, und drei Container sind von der Karte verschwunden. Sie sind im Lager, irgendwo. Das Schiff fährt mit der Tide, gefunden oder nicht.",
	"it": "Il sistema è caduto a metà turno e tre container sono spariti dalla mappa. Sono nel piazzale, da qualche parte. La nave parte con la marea, trovati o no.",
	"ru": "Посреди смены упала система, и три контейнера пропали с карты. Они где-то на площадке. Судно уйдёт с приливом — найдёте или нет.",
	"pl": "System padł w połowie zmiany i trzy kontenery zniknęły z mapy. Są gdzieś na placu. Statek wypływa z pływem, znajdziesz czy nie.",
	"tr": "Sistem vardiyanın ortasında çöktü ve üç konteyner haritadan kayboldu. Sahada bir yerdeler. Gemi bulunsun bulunmasın gelgitle kalkar."},
"special.vistoria_surpresa.title": {
	"pt_BR": "Vistoria Surpresa", "en": "Surprise Inspection",
	"es": "Inspección Sorpresa", "fr": "Inspection Surprise",
	"de": "Überraschungskontrolle", "it": "Ispezione a Sorpresa",
	"ru": "Внезапная проверка", "pl": "Niespodziewana Kontrola", "tr": "Sürpriz Denetim"},
"special.vistoria_surpresa.brief": {
	"pt_BR": "A fiscalização quer ver cinco contêineres específicos, agora, e o pátio está do jeito que está. Achar todos é o serviço; achar rápido é o prêmio.",
	"en": "Inspectors want to see five specific containers, now, and the yard is the way it is. Finding them all is the job; finding them fast is the prize.",
	"es": "La inspección quiere ver cinco contenedores concretos, ya, y el patio está como está. Encontrarlos todos es el trabajo; encontrarlos rápido es el premio.",
	"fr": "Les inspecteurs veulent voir cinq conteneurs précis, tout de suite, et le parc est comme il est. Tous les trouver, c'est le boulot ; vite, c'est la prime.",
	"de": "Die Kontrolle will fünf bestimmte Container sehen, sofort, und das Lager ist, wie es ist. Alle finden ist die Arbeit; schnell finden ist der Preis.",
	"it": "Gli ispettori vogliono vedere cinque container precisi, subito, e il piazzale è com'è. Trovarli tutti è il lavoro; trovarli in fretta è il premio.",
	"ru": "Проверяющие хотят увидеть пять конкретных контейнеров прямо сейчас, а площадка такая, какая есть. Найти все — работа; найти быстро — премия.",
	"pl": "Kontrola chce zobaczyć pięć konkretnych kontenerów, teraz, a plac jest, jaki jest. Znaleźć wszystkie to robota; znaleźć szybko to nagroda.",
	"tr": "Denetçiler beş belirli konteyneri hemen görmek istiyor ve saha olduğu gibi. Hepsini bulmak iş; hızlı bulmak ödül."},
"special.caminhao_atrasado.title": {
	"pt_BR": "Caminhão Atrasado", "en": "Late Lorry", "es": "Camión Atrasado",
	"fr": "Camion en Retard", "de": "Verspäteter Lkw", "it": "Camion in Ritardo",
	"ru": "Опаздывающий грузовик", "pl": "Spóźniona Ciężarówka", "tr": "Geciken Kamyon"},
"special.caminhao_atrasado.brief": {
	"pt_BR": "O reefer com a carga do navio ficou preso na avenida e o portão fecha com a maré. Assume o volante: desvia do trânsito, foge dos buracos e chega antes do gate fechar.",
	"en": "The reefer with the ship's cargo got stuck on the avenue and the gate closes with the tide. Take the wheel: dodge the traffic, avoid the potholes and get there before the gate shuts.",
	"es": "El reefer con la carga del barco quedó atrapado en la avenida y la puerta cierra con la marea. Toma el volante: esquiva el tráfico, huye de los baches y llega antes de que cierre el gate.",
	"fr": "Le frigo avec le fret du navire est coincé sur l'avenue et le portail ferme avec la marée. Prenez le volant : évitez la circulation, les nids-de-poule, et arrivez avant la fermeture.",
	"de": "Der Kühl-Lkw mit der Schiffsladung steckt auf der Avenida fest, und das Gate schließt mit der Tide. Ans Steuer: Verkehr ausweichen, Schlaglöcher meiden, vor Torschluss ankommen.",
	"it": "Il reefer con il carico della nave è bloccato sul viale e il varco chiude con la marea. Prendi il volante: schiva il traffico, evita le buche e arriva prima che chiuda il gate.",
	"ru": "Рефрижератор с грузом для судна застрял на проспекте, а ворота закрываются с приливом. Садитесь за руль: объезжайте пробки, ямы и успейте до закрытия.",
	"pl": "Chłodnia z ładunkiem statku utknęła na alei, a brama zamyka się z pływem. Siadaj za kółko: omijaj korki, uciekaj przed dziurami i zdąż przed zamknięciem.",
	"tr": "Geminin yükünü taşıyan frigorifik kamyon caddede sıkıştı ve kapı gelgitle kapanıyor. Direksiyona geç: trafikten kaç, çukurlardan sakın ve kapı kapanmadan yetiş."},
"special.frete_expresso.title": {
	"pt_BR": "Frete Expresso", "en": "Express Freight", "es": "Flete Exprés",
	"fr": "Fret Express", "de": "Expressfracht", "it": "Nolo Express",
	"ru": "Экспресс-фрахт", "pl": "Fracht Ekspresowy", "tr": "Ekspres Navlun"},
"special.frete_expresso.brief": {
	"pt_BR": "Remédio refrigerado pra embarcar no último feeder do dia. É hora do rush, choveu óleo na pista e o motorista travou. A estrada é sua.",
	"en": "Refrigerated medicine for the day's last feeder. It's rush hour, oil on the road and the driver froze. The road is yours.",
	"es": "Medicamento refrigerado para el último feeder del día. Es hora punta, llovió aceite en la pista y el conductor se bloqueó. La carretera es tuya.",
	"fr": "Des médicaments réfrigérés pour le dernier feeder du jour. C'est l'heure de pointe, il y a de l'huile sur la route et le chauffeur a paniqué. La route est à vous.",
	"de": "Gekühlte Medikamente für den letzten Feeder des Tages. Rushhour, Öl auf der Fahrbahn, der Fahrer ist erstarrt. Die Straße gehört dir.",
	"it": "Farmaci refrigerati per l'ultimo feeder del giorno. È l'ora di punta, c'è olio sulla strada e l'autista si è bloccato. La strada è tua.",
	"ru": "Охлаждённые лекарства на последний фидер дня. Час пик, масло на дороге, водитель растерялся. Дорога ваша.",
	"pl": "Chłodzone leki na ostatni feeder dnia. Godzina szczytu, olej na jezdni, kierowca zamarł. Droga należy do ciebie.",
	"tr": "Günün son besleyicisine soğutmalı ilaç. Trafik saati, yolda yağ var ve şoför dondu kaldı. Yol senin."},

