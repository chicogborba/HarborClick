# ----------------------------------------------------------- crew roles

"npc_role.sts.title": {
	"pt_BR": "Operador de portêiner", "en": "Quay crane operator",
	"es": "Operador de grúa pórtico", "fr": "Opérateur de portique",
	"de": "Containerbrückenfahrer", "it": "Gruista di banchina",
	"ru": "Оператор причального крана", "pl": "Operator suwnicy nabrzeżnej",
	"tr": "Rıhtım vinci operatörü"},
"npc_role.sts.duty": {
	"pt_BR": "Tira a caixa do porão e a põe em terra. Nada entra no porto pelo mar sem passar pelo spreader dele.",
	"en": "Lifts the box out of the hold and sets it ashore. Nothing enters the port by sea without passing through this spreader.",
	"es": "Saca la caja de la bodega y la pone en tierra. Nada entra al puerto por mar sin pasar por este spreader.",
	"fr": "Sort la caisse de la cale et la pose à terre. Rien n'entre au port par la mer sans passer par ce spreader.",
	"de": "Holt die Kiste aus dem Laderaum und setzt sie an Land. Nichts kommt übers Meer in den Hafen, ohne durch diesen Spreader zu gehen.",
	"it": "Tira fuori la cassa dalla stiva e la posa a terra. Nulla entra nel porto via mare senza passare da questo spreader.",
	"ru": "Достаёт ящик из трюма и ставит на берег. Ничто не попадает в порт с моря, минуя этот спредер.",
	"pl": "Wyjmuje skrzynię z ładowni i stawia na lądzie. Nic nie wchodzi do portu od morza bez tego spreadera.",
	"tr": "Kasayı ambardan alıp karaya koyar. Denizden limana hiçbir şey bu spreader'dan geçmeden girmez."},
"npc_role.estivador.title": {
	"pt_BR": "Conferente de pátio", "en": "Yard tally clerk",
	"es": "Controlador de patio", "fr": "Pointeur de parc", "de": "Lagerkontrolleur",
	"it": "Controllore di piazzale", "ru": "Тальман площадки", "pl": "Kontroler placu",
	"tr": "Saha sayım memuru"},
"npc_role.estivador.duty": {
	"pt_BR": "Confere o lacre e decide em que bloco a caixa fica. É quem sabe onde cada contêiner está.",
	"en": "Checks the seal and decides which block the box goes to. Knows where every container is.",
	"es": "Revisa el precinto y decide en qué bloque queda la caja. Sabe dónde está cada contenedor.",
	"fr": "Vérifie le scellé et décide dans quel bloc va la caisse. Sait où se trouve chaque conteneur.",
	"de": "Prüft die Plombe und entscheidet, in welchen Block die Kiste kommt. Weiß, wo jeder Container steht.",
	"it": "Controlla il sigillo e decide in che blocco va la cassa. Sa dove si trova ogni container.",
	"ru": "Проверяет пломбу и решает, в какой штабель пойдёт ящик. Знает, где каждый контейнер.",
	"pl": "Sprawdza plombę i decyduje, w którym bloku stanie skrzynia. Wie, gdzie jest każdy kontener.",
	"tr": "Mührü kontrol eder ve kasanın hangi bloğa gideceğine karar verir. Her konteynerin yerini bilir."},
"npc_role.rtg.title": {
	"pt_BR": "Operador de transtêiner", "en": "Yard gantry operator",
	"es": "Operador de grúa de patio", "fr": "Opérateur de portique de parc",
	"de": "Portalkranfahrer", "it": "Gruista di piazzale",
	"ru": "Оператор козлового крана", "pl": "Operator suwnicy placowej",
	"tr": "Saha vinci operatörü"},
"npc_role.rtg.duty": {
	"pt_BR": "Arruma a pilha por dentro. Sem ele o pátio ocupa o dobro de área para a mesma carga.",
	"en": "Keeps the stack in order from the inside. Without this job the yard takes twice the space for the same cargo.",
	"es": "Ordena la pila por dentro. Sin este puesto el patio ocupa el doble de área para la misma carga.",
	"fr": "Range la pile de l'intérieur. Sans ce poste, le parc prend deux fois plus de place pour le même fret.",
	"de": "Ordnet den Stapel von innen. Ohne diesen Posten braucht das Lager doppelt so viel Fläche für dieselbe Fracht.",
	"it": "Ordina la pila dall'interno. Senza questo ruolo il piazzale occupa il doppio dello spazio per lo stesso carico.",
	"ru": "Наводит порядок в штабеле изнутри. Без этой работы площадка заняла бы вдвое больше места.",
	"pl": "Porządkuje stos od środka. Bez tego stanowiska plac zajmuje dwa razy więcej miejsca na ten sam ładunek.",
	"tr": "İstifi içeriden düzenler. Bu iş olmasa saha aynı yük için iki kat yer kaplar."},
"npc_role.tt.title": {
	"pt_BR": "Motorista de terminal", "en": "Terminal driver",
	"es": "Conductor de terminal", "fr": "Chauffeur de terminal", "de": "Terminalfahrer",
	"it": "Autista di terminal", "ru": "Водитель терминала", "pl": "Kierowca terminalowy",
	"tr": "Terminal şoförü"},
"npc_role.tt.duty": {
	"pt_BR": "Puxa a carreta do costado ao bloco e volta vazio. Não tem placa de rua: é o elo entre o berço e a pilha.",
	"en": "Hauls the trailer from shipside to the block and comes back empty. No road plates: the link between berth and stack.",
	"es": "Lleva el remolque del costado al bloque y vuelve vacío. Sin matrícula de calle: es el eslabón entre muelle y pila.",
	"fr": "Tire la remorque du bord du navire au bloc et revient à vide. Pas de plaque routière : le lien entre quai et pile.",
	"de": "Zieht den Auflieger von der Bordwand zum Block und fährt leer zurück. Kein Straßenkennzeichen: das Bindeglied zwischen Kai und Stapel.",
	"it": "Porta il rimorchio dalla murata al blocco e torna vuoto. Niente targa stradale: è l'anello tra banchina e pila.",
	"ru": "Возит прицеп от борта к штабелю и обратно порожняком. Без номеров: связующее звено между причалом и штабелем.",
	"pl": "Ciągnie naczepę od burty do bloku i wraca pusty. Bez tablic drogowych: ogniwo między nabrzeżem a stosem.",
	"tr": "Dorseyi borda yanından bloğa çeker, boş döner. Yol plakası yok: rıhtım ile istif arasındaki halka."},
"npc_role.reach_stacker.title": {
	"pt_BR": "Operador de reach stacker", "en": "Reach stacker operator",
	"es": "Operador de reach stacker", "fr": "Opérateur de reach stacker",
	"de": "Reach-Stacker-Fahrer", "it": "Operatore di reach stacker",
	"ru": "Оператор ричстакера", "pl": "Operator reach stackera",
	"tr": "Reach stacker operatörü"},
"npc_role.reach_stacker.duty": {
	"pt_BR": "Pega a caixa de cima da pilha sem transtêiner e a entrega na rua. O reforço do elo terrestre.",
	"en": "Takes the box off the top of the stack without a gantry and delivers it to the road. Backup for the landside link.",
	"es": "Toma la caja de lo alto de la pila sin grúa de patio y la entrega en la calle. El refuerzo del enlace terrestre.",
	"fr": "Prend la caisse en haut de la pile sans portique et la livre côté route. Le renfort du maillon terrestre.",
	"de": "Holt die Kiste ohne Portal oben vom Stapel und bringt sie zur Straße. Verstärkung für die Landseite.",
	"it": "Prende la cassa in cima alla pila senza portale e la consegna su strada. Il rinforzo dell'anello terrestre.",
	"ru": "Снимает ящик с верха штабеля без крана и выдаёт на дорогу. Подкрепление сухопутного звена.",
	"pl": "Zdejmuje skrzynię ze szczytu stosu bez suwnicy i wydaje na drogę. Wsparcie ogniwa lądowego.",
	"tr": "Kasayı vinçsiz istifin tepesinden alır ve yola teslim eder. Kara bağlantısının yedeği."},
"npc_role.empilhadeira.title": {
	"pt_BR": "Operador de empilhadeira", "en": "Forklift operator",
	"es": "Operador de carretilla", "fr": "Cariste", "de": "Staplerfahrer",
	"it": "Carrellista", "ru": "Оператор погрузчика", "pl": "Operator wózka",
	"tr": "Forklift operatörü"},
"npc_role.empilhadeira.duty": {
	"pt_BR": "Move as caixas leves e as vazias, liberando os equipamentos grandes para o que é pesado.",
	"en": "Moves the light and empty boxes, freeing the big machines for the heavy work.",
	"es": "Mueve las cajas livianas y las vacías, liberando los equipos grandes para lo pesado.",
	"fr": "Déplace les caisses légères et vides, libérant les grosses machines pour le lourd.",
	"de": "Bewegt die leichten und leeren Kisten und hält die großen Geräte fürs Schwere frei.",
	"it": "Sposta le casse leggere e quelle vuote, liberando i mezzi grandi per il pesante.",
	"ru": "Перевозит лёгкие и пустые ящики, освобождая большие машины для тяжёлого.",
	"pl": "Przewozi lekkie i puste skrzynie, zwalniając duże maszyny do ciężkiej roboty.",
	"tr": "Hafif ve boş kasaları taşır, büyük makineleri ağır işe ayırır."},
"npc_role.alfandega.title": {
	"pt_BR": "Despachante do portão", "en": "Gate clerk",
	"es": "Despachante de la puerta", "fr": "Agent du portail", "de": "Gate-Abfertiger",
	"it": "Addetto al varco", "ru": "Диспетчер ворот", "pl": "Odprawiacz bramy",
	"tr": "Kapı memuru"},
"npc_role.alfandega.duty": {
	"pt_BR": "Libera o caminhão. A cancela só sobe depois que o papel dela está em ordem.",
	"en": "Clears the truck. The barrier only lifts once the paperwork is in order.",
	"es": "Libera el camión. La barrera solo sube cuando los papeles están en orden.",
	"fr": "Libère le camion. La barrière ne se lève que quand les papiers sont en règle.",
	"de": "Fertigt den Lkw ab. Die Schranke geht erst hoch, wenn die Papiere stimmen.",
	"it": "Libera il camion. La sbarra si alza solo quando le carte sono in ordine.",
	"ru": "Выпускает грузовик. Шлагбаум поднимается, только когда бумаги в порядке.",
	"pl": "Odprawia ciężarówkę. Szlaban idzie w górę dopiero, gdy papiery są w porządku.",
	"tr": "Kamyonu geçirir. Bariyer ancak evrak tamamsa kalkar."},
"npc_role.rebocador.title": {
	"pt_BR": "Comandante de rebocador", "en": "Tug master", "es": "Patrón de remolcador",
	"fr": "Patron de remorqueur", "de": "Schlepperkapitän",
	"it": "Comandante di rimorchiatore", "ru": "Капитан буксира",
	"pl": "Kapitan holownika", "tr": "Römorkör kaptanı"},
"npc_role.rebocador.duty": {
	"pt_BR": "Encosta o navio no cais e o tira de lá. Antes disso, não existe escala nenhuma.",
	"en": "Brings the ship alongside and takes it back out. Until then, there is no call at all.",
	"es": "Arrima el barco al muelle y lo saca de allí. Antes de eso, no existe escala.",
	"fr": "Accoste le navire au quai et l'en ressort. Avant ça, il n'y a pas d'escale.",
	"de": "Bringt das Schiff an den Kai und wieder hinaus. Vorher gibt es keinen Anlauf.",
	"it": "Accosta la nave alla banchina e la porta fuori. Prima di questo, non esiste scalo.",
	"ru": "Подводит судно к причалу и уводит обратно. До этого никакого захода нет.",
	"pl": "Dosuwa statek do nabrzeża i wyprowadza go. Wcześniej nie ma żadnego zawinięcia.",
	"tr": "Gemiyi rıhtıma yanaştırır ve geri çıkarır. O olmadan uğrak diye bir şey yoktur."},
"npc_role.road_truck.title": {
	"pt_BR": "Carreteiro", "en": "Haulier", "es": "Camionero", "fr": "Routier",
	"de": "Fernfahrer", "it": "Camionista", "ru": "Дальнобойщик", "pl": "Kierowca TIR-a",
	"tr": "Tır şoförü"},
"npc_role.road_truck.duty": {
	"pt_BR": "Traz o que a cidade exporta e leva para casa o que o navio descarregou. A outra porta do porto.",
	"en": "Brings what the city exports and takes home what the ship unloaded. The port's other door.",
	"es": "Trae lo que la ciudad exporta y lleva a casa lo que el barco descargó. La otra puerta del puerto.",
	"fr": "Apporte ce que la ville exporte et ramène ce que le navire a déchargé. L'autre porte du port.",
	"de": "Bringt, was die Stadt exportiert, und fährt heim, was das Schiff gelöscht hat. Die andere Tür des Hafens.",
	"it": "Porta ciò che la città esporta e riporta ciò che la nave ha scaricato. L'altra porta del porto.",
	"ru": "Привозит то, что город экспортирует, и увозит то, что выгрузило судно. Вторая дверь порта.",
	"pl": "Przywozi to, co miasto eksportuje, i zabiera to, co statek wyładował. Drugie drzwi portu.",
	"tr": "Şehrin ihraç ettiğini getirir, geminin boşalttığını götürür. Limanın öbür kapısı."},
"npc_role.default.title": {
	"pt_BR": "Trabalhador do porto", "en": "Port worker", "es": "Trabajador del puerto",
	"fr": "Ouvrier du port", "de": "Hafenarbeiter", "it": "Lavoratore del porto",
	"ru": "Портовый рабочий", "pl": "Pracownik portu", "tr": "Liman çalışanı"},

# ----------------------------------------------------------- named crew

"npc_special.alisson.dossier": {
	"pt_BR": "Veio da Wilson Sons de Rio Grande, onde aprendeu a ler um pátio inteiro de longe: sabe pela altura da pilha o que já saiu e o que ainda vai sair. Chegou dizendo que aqui o vento é mais manso. Hoje é o gerente de projetos do terminal, e é ele quem recebe quem chega.",
	"en": "Came from Wilson Sons in Rio Grande, where he learned to read a whole yard from afar: he can tell from the height of a stack what has left and what is still to go. Arrived saying the wind is gentler here. Today he's the terminal's project manager, and he's the one who welcomes newcomers.",
	"es": "Vino de Wilson Sons de Rio Grande, donde aprendió a leer un patio entero de lejos: sabe por la altura de la pila qué ya salió y qué falta salir. Llegó diciendo que aquí el viento es más manso. Hoy es el gerente de proyectos de la terminal, y es quien recibe a los que llegan.",
	"fr": "Venu de Wilson Sons à Rio Grande, où il a appris à lire tout un parc de loin : à la hauteur d'une pile, il sait ce qui est parti et ce qui reste. Arrivé en disant qu'ici le vent est plus doux. Aujourd'hui chef de projet du terminal, c'est lui qui accueille les nouveaux.",
	"de": "Kam von Wilson Sons in Rio Grande, wo er lernte, ein ganzes Lager aus der Ferne zu lesen: An der Stapelhöhe sieht er, was raus ist und was noch geht. Kam mit den Worten, hier sei der Wind sanfter. Heute ist er Projektleiter des Terminals und empfängt alle, die neu ankommen.",
	"it": "Viene dalla Wilson Sons di Rio Grande, dove ha imparato a leggere un piazzale intero da lontano: dall'altezza della pila sa cosa è uscito e cosa deve ancora uscire. È arrivato dicendo che qui il vento è più mite. Oggi è il project manager del terminal, ed è lui ad accogliere chi arriva.",
	"ru": "Пришёл из Wilson Sons в Риу-Гранди, где научился читать всю площадку издалека: по высоте штабеля знает, что ушло и что ещё уйдёт. Приехал со словами, что ветер тут мягче. Сейчас он руководитель проектов терминала и встречает новичков.",
	"pl": "Przyszedł z Wilson Sons w Rio Grande, gdzie nauczył się czytać cały plac z daleka: po wysokości stosu wie, co już wyjechało, a co jeszcze wyjedzie. Przyjechał, mówiąc, że tu wiatr jest łagodniejszy. Dziś jest kierownikiem projektów terminalu i to on wita nowych.",
	"tr": "Rio Grande'deki Wilson Sons'tan geldi; orada bütün bir sahayı uzaktan okumayı öğrendi: istifin yüksekliğinden neyin çıktığını, neyin çıkacağını bilir. Burada rüzgârın daha yumuşak olduğunu söyleyerek geldi. Bugün terminalin proje müdürü ve gelenleri o karşılıyor."},
"npc_special.alisson.trait": {
	"pt_BR": "Capacete azul, sempre. Diz que é para o pessoal do costado achar ele na neblina.",
	"en": "Blue hard hat, always. Says it's so the shipside crew can spot him in the fog.",
	"es": "Casco azul, siempre. Dice que es para que la gente del costado lo encuentre en la niebla.",
	"fr": "Casque bleu, toujours. Il dit que c'est pour que l'équipe du bord le repère dans le brouillard.",
	"de": "Immer blauer Helm. Sagt, damit die Leute an der Bordwand ihn im Nebel finden.",
	"it": "Casco blu, sempre. Dice che è perché quelli della murata lo trovino nella nebbia.",
	"ru": "Всегда в синей каске. Говорит — чтобы бригада у борта находила его в тумане.",
	"pl": "Zawsze niebieski kask. Mówi, że po to, by ekipa przy burcie znalazła go we mgle.",
	"tr": "Her zaman mavi baret. Borda ekibi onu siste bulsun diye olduğunu söylüyor."},
"npc_special.valdir.dossier": {
	"pt_BR": "Trinta anos na barra. Já entrou com navio na maré vazando e no nevoeiro fechado, e conta as duas histórias com a mesma calma.",
	"en": "Thirty years at the bar. Has brought ships in on an ebbing tide and in thick fog, and tells both stories with the same calm.",
	"es": "Treinta años en la barra. Ya entró con barcos con la marea bajando y con niebla cerrada, y cuenta las dos historias con la misma calma.",
	"fr": "Trente ans à la barre. Il a fait entrer des navires à marée descendante et dans le brouillard épais, et raconte les deux histoires avec le même calme.",
	"de": "Dreißig Jahre an der Barre. Hat Schiffe bei ablaufendem Wasser und dichtem Nebel reingebracht und erzählt beides mit derselben Ruhe.",
	"it": "Trent'anni alla barra. Ha portato dentro navi con la marea calante e nella nebbia fitta, e racconta le due storie con la stessa calma.",
	"ru": "Тридцать лет на баре. Заводил суда на отливе и в густом тумане и рассказывает обе истории одинаково спокойно.",
	"pl": "Trzydzieści lat na redzie. Wprowadzał statki przy odpływie i w gęstej mgle i opowiada obie historie z tym samym spokojem.",
	"tr": "Liman ağzında otuz yıl. Gemileri çekilen suda da yoğun siste de içeri aldı; iki hikâyeyi de aynı sakinlikle anlatır."},
"npc_special.valdir.trait": {
	"pt_BR": "Não usa rádio para atracar. Diz que o cabo fala mais alto.",
	"en": "Doesn't use the radio to berth. Says the line speaks louder.",
	"es": "No usa radio para atracar. Dice que el cabo habla más alto.",
	"fr": "N'utilise pas la radio pour accoster. Il dit que l'amarre parle plus fort.",
	"de": "Legt ohne Funk an. Sagt, die Leine spricht lauter.",
	"it": "Non usa la radio per ormeggiare. Dice che la cima parla più forte.",
	"ru": "Швартуется без рации. Говорит, что трос говорит громче.",
	"pl": "Nie używa radia przy cumowaniu. Mówi, że cuma mówi głośniej.",
	"tr": "Yanaşırken telsiz kullanmaz. Halatın daha yüksek sesle konuştuğunu söyler."},
"npc_special.neusa.dossier": {
	"pt_BR": "Conhece a placa de cada carreta que entra aqui e o nome de quem dirige. Papel errado não passa da guarita, e ninguém tenta duas vezes.",
	"en": "Knows the plate of every truck that comes in here and the name of whoever drives it. Wrong paperwork doesn't get past the booth, and nobody tries twice.",
	"es": "Conoce la matrícula de cada camión que entra aquí y el nombre de quien maneja. Papel equivocado no pasa de la caseta, y nadie lo intenta dos veces.",
	"fr": "Connaît la plaque de chaque camion qui entre ici et le nom de qui le conduit. Un mauvais papier ne passe pas la guérite, et personne n'essaie deux fois.",
	"de": "Kennt das Kennzeichen jedes Lkw, der hier reinkommt, und den Namen am Steuer. Falsche Papiere kommen nicht am Häuschen vorbei, und keiner versucht es zweimal.",
	"it": "Conosce la targa di ogni camion che entra qui e il nome di chi guida. Carte sbagliate non passano la garitta, e nessuno ci prova due volte.",
	"ru": "Знает номер каждого грузовика, что сюда въезжает, и имя водителя. Неверные бумаги дальше будки не проходят, и дважды никто не пытается.",
	"pl": "Zna tablicę każdej ciężarówki, która tu wjeżdża, i imię kierowcy. Zły papier nie przejdzie przez budkę, a nikt nie próbuje dwa razy.",
	"tr": "Buraya giren her kamyonun plakasını ve şoförün adını bilir. Yanlış evrak kulübeyi geçemez, kimse de iki kez denemez."},
"npc_special.neusa.trait": {
	"pt_BR": "Café às seis. A cancela abre depois do café.",
	"en": "Coffee at six. The barrier opens after the coffee.",
	"es": "Café a las seis. La barrera se abre después del café.",
	"fr": "Café à six heures. La barrière s'ouvre après le café.",
	"de": "Kaffee um sechs. Die Schranke öffnet nach dem Kaffee.",
	"it": "Caffè alle sei. La sbarra si apre dopo il caffè.",
	"ru": "Кофе в шесть. Шлагбаум открывается после кофе.",
	"pl": "Kawa o szóstej. Szlaban otwiera się po kawie.",
	"tr": "Kahve altıda. Bariyer kahveden sonra açılır."},

# ----------------------------------------------------- crew backgrounds

"npc_background.berco.0": {
	"pt_BR": "Subiu de sinaleiro a operador em quatro anos. Trabalha de cabine com a janela aberta, mesmo no frio.",
	"en": "Went from signaller to operator in four years. Works the cab with the window open, even in the cold.",
	"es": "Pasó de señalero a operador en cuatro años. Trabaja en la cabina con la ventana abierta, incluso con frío.",
	"fr": "De signaleur à opérateur en quatre ans. Travaille en cabine fenêtre ouverte, même par grand froid.",
	"de": "In vier Jahren vom Einweiser zum Fahrer. Arbeitet mit offenem Kabinenfenster, auch bei Kälte.",
	"it": "Da segnalatore a operatore in quattro anni. Lavora in cabina col finestrino aperto, anche al freddo.",
	"ru": "Четыре года от сигнальщика до оператора. Работает в кабине с открытым окном даже в холод.",
	"pl": "Cztery lata od sygnalisty do operatora. Pracuje w kabinie przy otwartym oknie, nawet w zimnie.",
	"tr": "Dört yılda işaretçilikten operatörlüğe geçti. Soğukta bile kabinde pencere açık çalışır."},
"npc_background.berco.1": {
	"pt_BR": "Conta os movimentos da própria escala em voz baixa. Erra por um, no máximo.",
	"en": "Counts the moves of each call under their breath. Off by one, at most.",
	"es": "Cuenta en voz baja los movimientos de la escala. Se equivoca por uno, como mucho.",
	"fr": "Compte à voix basse les mouvements de l'escale. Se trompe d'un, au pire.",
	"de": "Zählt die Hübe jedes Anlaufs leise mit. Liegt höchstens um einen daneben.",
	"it": "Conta sottovoce i movimenti dello scalo. Sbaglia di uno, al massimo.",
	"ru": "Считает движения каждого захода вполголоса. Ошибается максимум на один.",
	"pl": "Liczy po cichu ruchy każdego zawinięcia. Myli się najwyżej o jeden.",
	"tr": "Her uğrağın hamlelerini alçak sesle sayar. En fazla bir şaşırır."},
"npc_background.patio.0": {
	"pt_BR": "Anota tudo num caderno antes de anotar no sistema. Diz que o caderno nunca caiu.",
	"en": "Writes everything in a notebook before entering it in the system. Says the notebook has never crashed.",
	"es": "Anota todo en un cuaderno antes de anotarlo en el sistema. Dice que el cuaderno nunca se cayó.",
	"fr": "Note tout dans un carnet avant de le saisir dans le système. Dit que le carnet n'a jamais planté.",
	"de": "Schreibt alles erst ins Heft, dann ins System. Sagt, das Heft ist noch nie abgestürzt.",
	"it": "Annota tutto su un quaderno prima che nel sistema. Dice che il quaderno non è mai andato in crash.",
	"ru": "Записывает всё в тетрадь, прежде чем вносить в систему. Говорит, тетрадь ни разу не зависала.",
	"pl": "Zapisuje wszystko w zeszycie, zanim wpisze do systemu. Mówi, że zeszyt nigdy się nie zawiesił.",
	"tr": "Her şeyi sisteme girmeden önce deftere yazar. Defterin hiç çökmediğini söyler."},
"npc_background.patio.1": {
	"pt_BR": "Sabe de cor em que bloco está cada carga que chegou esta semana.",
	"en": "Knows by heart which block holds every load that arrived this week.",
	"es": "Sabe de memoria en qué bloque está cada carga que llegó esta semana.",
	"fr": "Sait par cœur dans quel bloc est chaque chargement arrivé cette semaine.",
	"de": "Weiß auswendig, in welchem Block jede Ladung dieser Woche steht.",
	"it": "Sa a memoria in che blocco è ogni carico arrivato questa settimana.",
	"ru": "Наизусть знает, в каком штабеле каждый груз, пришедший на этой неделе.",
	"pl": "Wie na pamięć, w którym bloku stoi każdy ładunek z tego tygodnia.",
	"tr": "Bu hafta gelen her yükün hangi blokta olduğunu ezbere bilir."},
"npc_background.pilha.0": {
	"pt_BR": "Empilha três de altura como quem guarda louça. Nunca precisou remover uma caixa duas vezes.",
	"en": "Stacks three high like putting away the good china. Has never had to dig out a box twice.",
	"es": "Apila a tres alturas como quien guarda la vajilla. Nunca tuvo que remover una caja dos veces.",
	"fr": "Empile sur trois hauteurs comme on range la vaisselle. N'a jamais dû déplacer une caisse deux fois.",
	"de": "Stapelt dreifach wie gutes Porzellan. Musste noch nie eine Kiste zweimal umsetzen.",
	"it": "Impila su tre livelli come chi ripone le stoviglie. Non ha mai dovuto spostare una cassa due volte.",
	"ru": "Ставит в три яруса, как убирают посуду. Ни один ящик не пришлось перекладывать дважды.",
	"pl": "Układa na trzy wysokości jak porcelanę. Żadnej skrzyni nie trzeba było przekładać dwa razy.",
	"tr": "Üç kat istifler, tabak dolaba diziyormuş gibi. Hiçbir kasayı iki kez aktarmak zorunda kalmadı."},
"npc_background.pilha.1": {
	"pt_BR": "Aprendeu no pátio de vazios e trouxe de lá o hábito de deixar corredor sobrando.",
	"en": "Learned in the empties yard and brought from there the habit of leaving a spare aisle.",
	"es": "Aprendió en el patio de vacíos y trajo de allí la costumbre de dejar pasillo de sobra.",
	"fr": "A appris au parc à vides et en a gardé l'habitude de laisser une allée en plus.",
	"de": "Hat im Leercontainerlager gelernt und die Angewohnheit mitgebracht, eine Gasse frei zu lassen.",
	"it": "Ha imparato nel piazzale dei vuoti e ne ha portato l'abitudine di lasciare un corridoio libero.",
	"ru": "Школа — площадка порожняка, оттуда и привычка оставлять запасной проход.",
	"pl": "Szkoła placu pustych, stamtąd nawyk zostawiania wolnej alejki.",
	"tr": "Boş konteyner sahasında öğrendi, oradan fazladan koridor bırakma alışkanlığını getirdi."},
"npc_background.estrada.0": {
	"pt_BR": "Faz a volta pelo portão mesmo quando dava para cortar. Diz que atalho no pátio custa caro.",
	"en": "Goes round by the gate even when cutting through would do. Says a shortcut in the yard costs dearly.",
	"es": "Da la vuelta por la puerta aunque podría cortar. Dice que el atajo en el patio sale caro.",
	"fr": "Fait le tour par le portail même quand on pourrait couper. Dit qu'un raccourci au parc coûte cher.",
	"de": "Fährt außen ums Gate, auch wenn Abkürzen ginge. Sagt, Abkürzungen im Lager kommen teuer.",
	"it": "Fa il giro dal varco anche quando potrebbe tagliare. Dice che una scorciatoia nel piazzale costa cara.",
	"ru": "Объезжает через ворота, даже когда можно срезать. Говорит, срезать на площадке — себе дороже.",
	"pl": "Objeżdża przez bramę, nawet gdy dałoby się skrócić. Mówi, że skrót na placu drogo kosztuje.",
	"tr": "Kestirme varken bile kapıdan dolanır. Sahada kestirmenin pahalıya patladığını söyler."},
"npc_background.estrada.1": {
	"pt_BR": "Conhece cada buraco da via de serviço e desvia sem tirar o pé.",
	"en": "Knows every pothole on the service road and swerves without easing off.",
	"es": "Conoce cada bache de la vía de servicio y lo esquiva sin levantar el pie.",
	"fr": "Connaît chaque nid-de-poule de la voie de service et l'évite sans lever le pied.",
	"de": "Kennt jedes Schlagloch der Betriebsstraße und weicht aus, ohne vom Gas zu gehen.",
	"it": "Conosce ogni buca della strada di servizio e la schiva senza alzare il piede.",
	"ru": "Знает каждую яму на служебной дороге и объезжает, не сбавляя.",
	"pl": "Zna każdą dziurę na drodze serwisowej i omija ją bez zdejmowania nogi z gazu.",
	"tr": "Servis yolundaki her çukuru bilir, ayağını kaldırmadan kaçar."},
"npc_background.portao.0": {
	"pt_BR": "Fecha a papelada antes da carreta parar. Ninguém espera na guarita por causa dela.",
